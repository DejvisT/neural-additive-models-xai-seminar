        dtype: DT_STRING
        tensor_shape {
        }
        string_val: "_temp\\part"
      }
    }
  }
}
node {
  name: "save_1/Select"
  op: "Select"
  input: "save_1/StaticRegexFullMatch"
  input: "save_1/Const_1"
