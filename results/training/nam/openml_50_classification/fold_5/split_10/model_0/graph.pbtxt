  op: "ShardedFilename"
  input: "save_1/StringJoin"
  input: "save_1/ShardedFilename/shard"
  input: "save_1/num_shards"
  device: "/device:CPU:0"
  attr {
    key: "_output_shapes"
    value {
      list {
        shape {
        }
      }
    }
  }
}
